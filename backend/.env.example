DATABASE_URL=postgres://crew:crew@localhost:5432/crew_management
# Applies database/schema.sql on startup if the "users" table doesn't exist yet — useful for a
# fresh cloud deploy with an empty managed Postgres, since there's no way to run `psql -f` by hand
# there. Leave false for local dev / docker-compose, which already apply the schema explicitly.
AUTO_MIGRATE=false
# Also applies database/seed.sql (demo accounts, all password "password123") when AUTO_MIGRATE
# just created the schema. Never enable this against a database with real data.
SEED_DEMO_DATA=false
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PORT=4000
OBJECT_STORE_BUCKET=crew-management-assets
OBJECT_STORE_ENDPOINT=https://s3.amazonaws.com
# Only needed when OBJECT_STORE_ENDPOINT is an internal/private address (e.g. docker-compose's
# "minio" hostname) that a browser or mobile client can't resolve — set this to the
# externally-reachable endpoint used solely for signing download URLs. Leave unset when
# OBJECT_STORE_ENDPOINT is already public (e.g. real S3 or MinIO behind a public domain).
OBJECT_STORE_PUBLIC_ENDPOINT=
OBJECT_STORE_REGION=auto
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=
FCM_SERVICE_ACCOUNT_JSON=./firebase-service-account.json
QR_TRANSFER_SECRET=change-me-qr
GEOFENCE_DEFAULT_RADIUS_M=75
